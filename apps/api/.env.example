# MongoDB Connection
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ahmadstore?retryWrites=true&w=majority

# LLM Endpoint (Your Colab ngrok URL)
# Update this every time you restart Colab or ngrok
# Make sure to add /generate at the end
LLM_ENDPOINT=https://your-subdomain.ngrok-free.dev/generate

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS (for local development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: For production deployment
# MONGODB_URI=mongodb+srv://prod-user:prod-pass@cluster0.xxxxx.mongodb.net/ahmadstore-prod
# LLM_ENDPOINT=https://your-persistent-llm-service.com/generate
# NODE_ENV=production
